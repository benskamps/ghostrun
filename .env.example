# Server-side only. Set in Vercel > Project > Settings > Environment Variables.
# Never prefix with VITE_ (that would ship it to the browser).
ANTHROPIC_API_KEY=
# Optional: all-phones cap per hour per instance (default 60), and a kill switch
PROOF_HOURLY_CAP=
PROOF_OFF=
# Optional: chore breakdown cap per hour per instance (default 150), and its own kill switch
BREAKDOWN_HOURLY_CAP=
BREAKDOWN_OFF=
